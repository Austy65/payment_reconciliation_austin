{
  "info": {
    "name": "Setu Payment Reconciliation Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Full API test suite for the Setu take-home assignment."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Ingest — payment_initiated",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/events",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"demo-evt-001\",\n  \"event_type\": \"payment_initiated\",\n  \"transaction_id\": \"demo-txn-001\",\n  \"merchant_id\": \"merchant_1\",\n  \"merchant_name\": \"QuickMart\",\n  \"amount\": 5000.00,\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-06-01T10:00:00+00:00\"\n}"
            }
          }
        },
        {
          "name": "Ingest — payment_processed",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/events",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"demo-evt-002\",\n  \"event_type\": \"payment_processed\",\n  \"transaction_id\": \"demo-txn-001\",\n  \"merchant_id\": \"merchant_1\",\n  \"merchant_name\": \"QuickMart\",\n  \"amount\": 5000.00,\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-06-01T10:01:00+00:00\"\n}"
            }
          }
        },
        {
          "name": "Ingest — settled",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/events",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"demo-evt-003\",\n  \"event_type\": \"settled\",\n  \"transaction_id\": \"demo-txn-001\",\n  \"merchant_id\": \"merchant_1\",\n  \"merchant_name\": \"QuickMart\",\n  \"amount\": 5000.00,\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-06-01T10:05:00+00:00\"\n}"
            }
          }
        },
        {
          "name": "Ingest — duplicate (idempotency test)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/events",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"demo-evt-001\",\n  \"event_type\": \"payment_initiated\",\n  \"transaction_id\": \"demo-txn-001\",\n  \"merchant_id\": \"merchant_1\",\n  \"merchant_name\": \"QuickMart\",\n  \"amount\": 5000.00,\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-06-01T10:00:00+00:00\"\n}"
            }
          }
        },
        {
          "name": "Ingest — failed transaction (discrepancy seed)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/events",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"disc-evt-001\",\n  \"event_type\": \"payment_initiated\",\n  \"transaction_id\": \"disc-txn-001\",\n  \"merchant_id\": \"merchant_2\",\n  \"merchant_name\": \"FreshBasket\",\n  \"amount\": 12000.00,\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-06-02T09:00:00+00:00\"\n}"
            }
          }
        },
        {
          "name": "Ingest — payment_failed then settled (bad state)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/events",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"disc-evt-002\",\n  \"event_type\": \"payment_failed\",\n  \"transaction_id\": \"disc-txn-001\",\n  \"merchant_id\": \"merchant_2\",\n  \"merchant_name\": \"FreshBasket\",\n  \"amount\": 12000.00,\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-06-02T09:01:00+00:00\"\n}"
            }
          }
        },
        {
          "name": "Ingest — settled on failed (discrepancy)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/events",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"disc-evt-003\",\n  \"event_type\": \"settled\",\n  \"transaction_id\": \"disc-txn-001\",\n  \"merchant_id\": \"merchant_2\",\n  \"merchant_name\": \"FreshBasket\",\n  \"amount\": 12000.00,\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-06-02T09:02:00+00:00\"\n}"
            }
          }
        },
        {
          "name": "Ingest — invalid event type (expect 422)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/events",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"bad-evt-001\",\n  \"event_type\": \"refunded\",\n  \"transaction_id\": \"bad-txn-001\",\n  \"merchant_id\": \"merchant_1\",\n  \"merchant_name\": \"QuickMart\",\n  \"amount\": 100.00,\n  \"currency\": \"INR\",\n  \"timestamp\": \"2026-06-01T10:00:00+00:00\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "List all transactions",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/transactions"
          }
        },
        {
          "name": "List — filter by merchant",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/transactions?merchant_id=merchant_1",
              "query": [{ "key": "merchant_id", "value": "merchant_1" }]
            }
          }
        },
        {
          "name": "List — filter by status=settled",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/transactions?status=settled",
              "query": [{ "key": "status", "value": "settled" }]
            }
          }
        },
        {
          "name": "List — date range filter",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/transactions?from_date=2026-06-01T00:00:00Z&to_date=2026-06-30T23:59:59Z",
              "query": [
                { "key": "from_date", "value": "2026-06-01T00:00:00Z" },
                { "key": "to_date", "value": "2026-06-30T23:59:59Z" }
              ]
            }
          }
        },
        {
          "name": "List — pagination page 2",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/transactions?page=2&page_size=5",
              "query": [
                { "key": "page", "value": "2" },
                { "key": "page_size", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "List — sort by amount desc",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/transactions?sort_by=amount&sort_dir=desc",
              "query": [
                { "key": "sort_by", "value": "amount" },
                { "key": "sort_dir", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "Get transaction detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/transactions/demo-txn-001"
          }
        },
        {
          "name": "Get transaction — not found (expect 404)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/transactions/does-not-exist"
          }
        }
      ]
    },
    {
      "name": "Reconciliation",
      "item": [
        {
          "name": "Summary — all",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/reconciliation/summary"
          }
        },
        {
          "name": "Summary — filter by merchant",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/reconciliation/summary?merchant_id=merchant_1",
              "query": [{ "key": "merchant_id", "value": "merchant_1" }]
            }
          }
        },
        {
          "name": "Summary — date range",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/reconciliation/summary?from_date=2026-01-01&to_date=2026-06-30",
              "query": [
                { "key": "from_date", "value": "2026-01-01" },
                { "key": "to_date", "value": "2026-06-30" }
              ]
            }
          }
        },
        {
          "name": "Discrepancies — all",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/reconciliation/discrepancies"
          }
        },
        {
          "name": "Discrepancies — filter by merchant",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/reconciliation/discrepancies?merchant_id=merchant_2",
              "query": [{ "key": "merchant_id", "value": "merchant_2" }]
            }
          }
        },
        {
          "name": "Discrepancies — filter by reason substring",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/reconciliation/discrepancies?reason=failed+payment",
              "query": [{ "key": "reason", "value": "failed payment" }]
            }
          }
        },
        {
          "name": "Discrepancies — paginated",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/reconciliation/discrepancies?page=1&page_size=10",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "10" }
              ]
            }
          }
        }
      ]
    }
  ]
}
